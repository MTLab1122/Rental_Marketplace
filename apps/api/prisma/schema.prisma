datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, uuidOssp(map: "uuid-ossp")]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

// ==========================================
// ENUMS
// ==========================================

enum UserRoleName {
  TENANT
  LANDLORD
  ADMIN
  SUPER_ADMIN
  MODERATOR
  SUPPORT
}

enum TenantType {
  STUDENT
  FAMILY
}

enum PropertyEligibility {
  STUDENTS_ONLY
  FAMILIES_ONLY
}

enum PropertyType {
  SINGLE_ROOM
  SHARED_ROOM
  HOSTEL
  PORTION
  APARTMENT
  HOUSE
  RESIDENTIAL_UNIT
}

enum PropertyStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
  RENTED
  UNAVAILABLE
  DELETED
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum InquiryStatus {
  SUBMITTED
  SEEN
  REPLIED
  ACCEPTED
  DECLINED
  CLOSED
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

enum ReportReason {
  FAKE_LISTING
  WRONG_LOCATION
  MISLEADING_INFORMATION
  DISCRIMINATION
  HARASSMENT
  DUPLICATE_LISTING
  UNSAFE_PROPERTY
  OTHER
}

enum ImageModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ViewSource {
  MOBILE
  WEB
  ADMIN_REFERRAL
}

enum NotificationType {
  INQUIRY_RECEIVED
  INQUIRY_REPLIED
  LISTING_APPROVED
  LISTING_REJECTED
  LISTING_SUSPENDED
  MESSAGE_RECEIVED
  SYSTEM
  NEW_LISTING_ALERT
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
  REMOVED
}

enum ReviewReportReason {
  SPAM
  PROFANITY
  HARASSMENT
  DEFAMATION
  CONFLICT_OF_INTEREST
  OTHER
}

enum ReviewModerationAction {
  APPROVE
  REJECT
  HIDE
  RESTORE
  REMOVE
}

enum TrustEventType {
  INQUIRY_ACCEPTED
  INQUIRY_REPLIED
  REVIEW_RECEIVED
  REVIEW_REPORTED
  VERIFICATION_APPROVED
  BADGE_GRANTED
  BADGE_REVOKED
  COMPLAINT_UPHELD
}

enum TrustBadge {
  VERIFIED_LANDLORD
  FAST_RESPONDER
  HIGHLY_RATED
  TOP_LISTING
  NEW_LISTING
  PREMIUM_LISTING
}

enum AlertFrequency {
  INSTANT
  DAILY
  WEEKLY
}

enum AlertDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
  SKIPPED
}

// ==========================================
// AUTHENTICATION & ACCESS CONTROL MODELS
// ==========================================

model User {
  id                  String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email               String       @unique @db.VarChar(255)
  phoneNumber         String       @unique @db.VarChar(20)
  passwordHash        String       @db.VarChar(255)
  fullName            String       @db.VarChar(150)
  isVerified          Boolean      @default(false)
  isSuspended         Boolean      @default(false)
  suspendedReason     String?      @db.VarChar(255)
  failedLoginAttempts Int          @default(0)
  lockedUntil         DateTime?    @db.Timestamptz(6)
  passwordResetToken  String?      @db.VarChar(255)
  passwordResetExpires DateTime?   @db.Timestamptz(6)
  mfaSecret           String?      @db.VarChar(255)
  isMfaEnabled        Boolean      @default(false)
  createdAt           DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime     @updatedAt @db.Timestamptz(6)
  deletedAt           DateTime?    @db.Timestamptz(6)

  // Profiles
  tenantProfile   TenantProfile?
  landlordProfile LandlordProfile?
  adminProfile    AdminProfile?

  // RBAC Relations
  roles          UserRole[]
  refreshTokens  RefreshToken[]
  auditLogs      AuditLog[]             @relation("ActorAuditLogs")
  deviceTokens   DeviceToken[]
  notifications  Notification[]

  // Domain Relations
  properties          Property[]        @relation("LandlordProperties")
  approvedProperties  Property[]        @relation("AdminApprovedProperties")
  favorites           Favorite[]
  inquiriesSent       Inquiry[]         @relation("TenantInquiries")
  inquiriesReceived   Inquiry[]         @relation("LandlordInquiries")
  conversationParts   ConversationParticipant[]
  sentMessages        Message[]         @relation("SentMessages")
  conversationsBlocked Conversation[]   @relation("BlockedConversations")
  reportsFiled        Report[]          @relation("ReportsFiled")
  reportsResolved     Report[]          @relation("ReportsResolved")
  verificationRecords VerificationRecord[]
  verifiedRecords     VerificationRecord[] @relation("AdminVerifiedRecords")

  // Reviews, Reputation & Trust Relations
  reviewsWritten              Review[]                   @relation("TenantReviews")
  reviewsReceived             Review[]                   @relation("LandlordReviews")
  reviewReplies               ReviewReply[]
  reviewReportsFiled          ReviewReport[]             @relation("ReviewReportsFiled")
  reviewReportsResolved       ReviewReport[]             @relation("ReviewReportsResolved")
  reviewModerations           ReviewModeration[]
  landlordReputationSnapshots LandlordReputationSnapshot[]

  // Saved Searches, Alerts & Personalization Relations
  savedSearches              SavedSearch[]
  searchAlerts               SearchAlert[]
  recentlyViewedProperties   RecentlyViewedProperty[]
  recommendationEvents       RecommendationEvent[]
  propertyImpressions        PropertyImpression[]
  propertyClicks             PropertyClick[]
  searchQueryLogs            SearchQueryLog[]
  notificationPreference     NotificationPreference?

  @@index([email])
  @@index([phoneNumber])
  @@index([isVerified])
  @@index([isSuspended])
  @@map("users")
}

model Role {
  id          String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name        UserRoleName     @unique
  description String?          @db.VarChar(255)
  isSystem    Boolean          @default(true)
  createdAt   DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(6)

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model UserRole {
  id         String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId     String       @db.Uuid
  roleId     String       @db.Uuid
  assignedAt DateTime     @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model Permission {
  id          String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  code        String           @unique @db.VarChar(100)
  module      String           @db.VarChar(50)
  description String?          @db.VarChar(255)
  createdAt   DateTime         @default(now()) @db.Timestamptz(6)

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  createdAt    DateTime   @default(now()) @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique @db.VarChar(255)
  familyId   String    @db.Uuid
  deviceId   String?   @db.VarChar(100)
  userAgent  String?   @db.VarChar(255)
  isRevoked  Boolean   @default(false)
  expiresAt  DateTime  @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// ==========================================
// USER PROFILES
// ==========================================

model TenantProfile {
  id                 String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId             String     @unique @db.Uuid
  tenantType         TenantType
  institutionName    String?    @db.VarChar(150)
  studentIdCardUrl   String?    @db.VarChar(500)
  familyMembersCount Int?       @db.SmallInt
  preferredLocalities Json?
  createdAt          DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime   @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantType])
  @@map("tenant_profiles")
}

model LandlordProfile {
  id             String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId         String   @unique @db.Uuid
  cnicNumber     String?  @unique @db.VarChar(20)
  isCnicVerified Boolean  @default(false)
  businessName   String?  @db.VarChar(150)
  officeAddress  String?  @db.VarChar(255)
  whatsappNumber String?  @db.VarChar(20)
  whatsappEnabled Boolean @default(false)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("landlord_profiles")
}

model AdminProfile {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId      String   @unique @db.Uuid
  department  String?  @db.VarChar(100)
  designation String?  @db.VarChar(100)
  canModerate Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_profiles")
}

// ==========================================
// LOCALITIES & PROPERTIES
// ==========================================

model Locality {
  id              String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name            String    @unique @db.VarChar(100)
  slug            String    @unique @db.VarChar(100)
  description     String?   @db.Text
  postalCode      String    @db.VarChar(10)
  latitude        Decimal   @db.Decimal(10, 7)
  longitude       Decimal   @db.Decimal(10, 7)
  boundaryGeoJson Json?
  isActive        Boolean   @default(true)
  sortOrder       Int       @default(0) @db.SmallInt
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt       DateTime? @db.Timestamptz(6)

  properties Property[]
  searchQueryLogs SearchQueryLog[]
  demandSnapshots LocalityDemandSnapshot[]

  @@index([slug])
  @@index([isActive])
  @@map("localities")
}

model Property {
  id                 String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  landlordId         String              @db.Uuid
  localityId         String              @db.Uuid
  title              String              @db.VarChar(255)
  slug               String              @unique @db.VarChar(255)
  description        String              @db.Text
  eligibility        PropertyEligibility
  propertyType       PropertyType
  status             PropertyStatus      @default(DRAFT)
  monthlyRentPkr     Decimal             @db.Decimal(12, 2)
  securityDepositPkr Decimal             @db.Decimal(12, 2)
  bedrooms           Int                 @db.SmallInt
  bathrooms          Int                 @db.SmallInt
  areaSqFt           Decimal?            @db.Decimal(10, 2)
  furnishing         String?             @db.VarChar(50)
  address            String              @db.VarChar(255)
  addressNote        String?             @db.VarChar(255)
  latitude           Decimal             @db.Decimal(10, 7)
  longitude          Decimal             @db.Decimal(10, 7)
  isAvailable        Boolean             @default(true)
  isFeatured         Boolean             @default(false)
  viewCount          Int                 @default(0)
  inquiryCount       Int                 @default(0)
  favoriteCount      Int                 @default(0)
  whatsappNumber     String?             @db.VarChar(20)
  showWhatsapp       Boolean             @default(false)
  verifiedAt         DateTime?           @db.Timestamptz(6)
  approvedById       String?             @db.Uuid
  rejectionReason    String?             @db.VarChar(255)
  suspensionReason   String?             @db.VarChar(255)
  availableFromDate  DateTime?           @db.Date
  isDuplicateWarning Boolean             @default(false)
  isDuplicateConfirmed Boolean           @default(false)
  duplicateOfPropertyId String?          @db.Uuid
  createdAt          DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(6)
  deletedAt          DateTime?           @db.Timestamptz(6)

  landlord   User      @relation("LandlordProperties", fields: [landlordId], references: [id], onDelete: Restrict)
  locality   Locality  @relation(fields: [localityId], references: [id], onDelete: Restrict)
  approvedBy User?     @relation("AdminApprovedProperties", fields: [approvedById], references: [id], onDelete: SetNull)

  images        PropertyImage[]
  amenities     PropertyAmenity[]
  favorites     Favorite[]
  inquiries     Inquiry[]
  conversations Conversation[]
  viewEvents    PropertyViewEvent[]
  reviews       Review[]
  qualitySnapshots PropertyQualitySnapshot[]
  searchAlerts     SearchAlert[]
  recentlyViewed   RecentlyViewedProperty[]
  recommendations  RecommendationEvent[]
  impressions      PropertyImpression[]
  clicks           PropertyClick[]

  // High performance composite indexes
  @@index([status, eligibility, isAvailable, localityId])
  @@index([monthlyRentPkr])
  @@index([bedrooms, propertyType])
  @@index([createdAt])
  @@index([landlordId])
  @@index([status, deletedAt])
  @@map("properties")
}

model PropertyImage {
  id               String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  propertyId       String                @db.Uuid
  url              String                @db.VarChar(500)
  thumbnailUrl     String?               @db.VarChar(500)
  publicId         String?               @db.VarChar(255)
  storageKey       String?               @db.VarChar(255)
  caption          String?               @db.VarChar(150)
  isPrimary        Boolean               @default(false)
  sortOrder        Int                   @default(0) @db.SmallInt
  moderationStatus ImageModerationStatus @default(PENDING)
  rejectionReason  String?               @db.VarChar(255)
  moderatedById    String?               @db.Uuid
  moderatedAt      DateTime?             @db.Timestamptz(6)
  mimeType         String?               @db.VarChar(50)
  fileSizeBytes    Int?
  width            Int?
  height           Int?
  checksum         String?               @db.VarChar(64)
  createdAt        DateTime              @default(now()) @db.Timestamptz(6)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([propertyId, moderationStatus])
  @@map("property_images")
}

model Amenity {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name      String   @unique @db.VarChar(100)
  code      String   @unique @db.VarChar(50)
  category  String   @db.VarChar(50)
  icon      String?  @db.VarChar(50)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  properties PropertyAmenity[]

  @@map("amenities")
}

model PropertyAmenity {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  propertyId String   @db.Uuid
  amenityId  String   @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenity  Amenity  @relation(fields: [amenityId], references: [id], onDelete: Restrict)

  @@unique([propertyId, amenityId])
  @@index([propertyId])
  @@index([amenityId])
  @@map("property_amenities")
}

model PropertyViewEvent {
  id         String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  propertyId String     @db.Uuid
  viewerId   String?    @db.Uuid
  ipHash     String?    @db.VarChar(64)
  source     ViewSource @default(WEB)
  localityId String?    @db.Uuid
  createdAt  DateTime   @default(now()) @db.Timestamptz(6)

  property   Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, createdAt])
  @@index([propertyId, viewerId])
  @@index([propertyId, ipHash])
  @@index([propertyId, source])
  @@index([localityId])
  @@map("property_view_events")
}

// ==========================================
// ENGAGEMENT: FAVORITES, INQUIRIES, CHAT
// ==========================================

model Favorite {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId     String   @db.Uuid
  propertyId String   @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([userId])
  @@index([propertyId])
  @@map("favorites")
}

model Inquiry {
  id                     String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  propertyId             String        @db.Uuid
  tenantId               String        @db.Uuid
  landlordId             String        @db.Uuid
  status                 InquiryStatus @default(SUBMITTED)
  message                String        @db.Text
  proposedMoveInDate     DateTime?     @db.Date
  proposedRentPkr        Int?
  preferredContactMethod String?       @default("IN_APP") @db.VarChar(20)
  createdAt              DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime      @updatedAt @db.Timestamptz(6)

  property     Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant       User          @relation("TenantInquiries", fields: [tenantId], references: [id], onDelete: Restrict)
  landlord     User          @relation("LandlordInquiries", fields: [landlordId], references: [id], onDelete: Restrict)
  conversation Conversation?
  reviews      Review[]

  @@index([tenantId])
  @@index([landlordId])
  @@index([propertyId])
  @@index([status])
  @@map("inquiries")
}

model Conversation {
  id            String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  inquiryId     String?   @unique @db.Uuid
  propertyId    String?   @db.Uuid
  isBlocked     Boolean   @default(false)
  blockedById   String?   @db.Uuid
  blockedAt     DateTime? @db.Timestamptz(6)
  lastMessageAt DateTime? @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  inquiry      Inquiry?                  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  property     Property?                 @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  blockedBy    User?                     @relation("BlockedConversations", fields: [blockedById], references: [id], onDelete: SetNull)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([inquiryId])
  @@index([propertyId])
  @@index([isBlocked])
  @@map("conversations")
}

model ConversationParticipant {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  conversationId String    @db.Uuid
  userId         String    @db.Uuid
  lastReadAt     DateTime? @db.Timestamptz(6)
  joinedAt       DateTime  @default(now()) @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  conversationId String    @db.Uuid
  senderId       String    @db.Uuid
  content        String    @db.Text
  isRead         Boolean   @default(false)
  readAt         DateTime? @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  deletedAt      DateTime? @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Restrict)

  @@index([conversationId])
  @@index([senderId])
  @@map("messages")
}

// ==========================================
// NOTIFICATIONS, DEVICES & VERIFICATIONS
// ==========================================

model Notification {
  id        String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  title     String           @db.VarChar(150)
  body      String           @db.Text
  data      Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model DeviceToken {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId       String   @db.Uuid
  fcmToken     String   @unique @db.VarChar(255)
  platform     String   @db.VarChar(20)
  lastActiveAt DateTime @default(now()) @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

model Report {
  id              String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  reporterId      String       @db.Uuid
  targetType      String       @db.VarChar(50)
  targetId        String       @db.VarChar(50)
  reason          ReportReason
  details         String?      @db.Text
  status          ReportStatus @default(OPEN)
  resolvedById    String?      @db.Uuid
  resolutionNotes String?      @db.Text
  createdAt       DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(6)

  reporter   User  @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Restrict)
  resolvedBy User? @relation("ReportsResolved", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([reporterId])
  @@index([targetType, targetId])
  @@index([status])
  @@index([reporterId, targetType, targetId])
  @@map("reports")
}

model VerificationRecord {
  id                  String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId              String             @db.Uuid
  fullName            String?            @db.VarChar(150)
  phoneNumber         String?            @db.VarChar(20)
  cnicNumberHash      String?            @db.VarChar(64)
  cnicNumberEncrypted String?            @db.VarChar(255)
  cnicNumberMasked    String?            @db.VarChar(20)
  cnicFrontUrl        String?            @db.VarChar(500)
  cnicBackUrl         String?            @db.VarChar(500)
  selfieUrl           String?            @db.VarChar(500)
  address             String?            @db.VarChar(255)
  documentType        String             @default("CNIC") @db.VarChar(50)
  documentUrl         String             @default("") @db.VarChar(500)
  status              VerificationStatus @default(PENDING)
  reviewNotes         String?            @db.Text
  verifiedById        String?            @db.Uuid
  verifiedAt          DateTime?          @db.Timestamptz(6)
  rejectionReason     String?            @db.VarChar(255)
  createdAt           DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime           @updatedAt @db.Timestamptz(6)

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  verifiedBy User? @relation("AdminVerifiedRecords", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([cnicNumberHash])
  @@map("verification_records")
}

// ==========================================
// AUDIT LOG
// ==========================================

model AuditLog {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  actorId    String?  @db.Uuid
  action     String   @db.VarChar(100)
  targetType String   @db.VarChar(50)
  targetId   String?  @db.VarChar(50)
  before     Json?
  after      Json?
  ipAddress  String?  @db.VarChar(45)
  userAgent  String?  @db.VarChar(255)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  actor User? @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ==========================================
// SYSTEM SETTINGS & FEATURE FLAGS
// ==========================================

model SystemSetting {
  key         String   @id @db.VarChar(100)
  value       Json
  description String?  @db.VarChar(255)
  updatedBy   String?  @db.Uuid
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  @@map("system_settings")
}

// ==========================================
// PHASE 11: REVIEWS, REPUTATION & TRUST MODELS
// ==========================================

model Review {
  id                   String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  propertyId           String       @db.Uuid
  tenantId             String       @db.Uuid
  landlordId           String       @db.Uuid
  inquiryId            String       @db.Uuid
  overallRating        Int          @db.SmallInt
  communicationRating  Int          @db.SmallInt
  accuracyRating       Int          @db.SmallInt
  safetyRating         Int          @db.SmallInt
  valueForMoneyRating  Int          @db.SmallInt
  comment              String       @db.Text
  images               Json?
  status               ReviewStatus @default(APPROVED)
  ipAddress            String?      @db.VarChar(45)
  userAgent            String?      @db.VarChar(255)
  isEdited             Boolean      @default(false)
  editedAt             DateTime?    @db.Timestamptz(6)
  createdAt            DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime     @updatedAt @db.Timestamptz(6)
  deletedAt            DateTime?    @db.Timestamptz(6)

  property    Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant      User               @relation("TenantReviews", fields: [tenantId], references: [id], onDelete: Restrict)
  landlord    User               @relation("LandlordReviews", fields: [landlordId], references: [id], onDelete: Restrict)
  inquiry     Inquiry            @relation(fields: [inquiryId], references: [id], onDelete: Restrict)
  reply       ReviewReply?
  reports     ReviewReport[]
  moderations ReviewModeration[]

  @@unique([tenantId, propertyId, inquiryId])
  @@index([propertyId, status])
  @@index([landlordId, status])
  @@index([tenantId])
  @@index([status])
  @@map("reviews")
}

model ReviewReply {
  id         String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  reviewId   String       @unique @db.Uuid
  landlordId String       @db.Uuid
  content    String       @db.Text
  status     ReviewStatus @default(APPROVED)
  createdAt  DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime     @updatedAt @db.Timestamptz(6)

  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  landlord User   @relation(fields: [landlordId], references: [id], onDelete: Restrict)

  @@index([landlordId])
  @@map("review_replies")
}

model ReviewReport {
  id              String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  reviewId        String             @db.Uuid
  reporterId      String             @db.Uuid
  reason          ReviewReportReason
  details         String?            @db.Text
  status          ReportStatus       @default(OPEN)
  resolvedById    String?            @db.Uuid
  resolutionNotes String?            @db.Text
  createdAt       DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @db.Timestamptz(6)

  review     Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reporter   User   @relation("ReviewReportsFiled", fields: [reporterId], references: [id], onDelete: Restrict)
  resolvedBy User?  @relation("ReviewReportsResolved", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([reviewId])
  @@index([reporterId])
  @@index([status])
  @@map("review_reports")
}

model ReviewModeration {
  id          String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  reviewId    String                 @db.Uuid
  moderatorId String                 @db.Uuid
  action      ReviewModerationAction
  reason      String?                @db.VarChar(255)
  notes       String?                @db.Text
  createdAt   DateTime               @default(now()) @db.Timestamptz(6)

  review    Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  moderator User   @relation(fields: [moderatorId], references: [id], onDelete: Restrict)

  @@index([reviewId])
  @@index([moderatorId])
  @@map("review_moderations")
}

model LandlordReputationSnapshot {
  id                         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  landlordId                 String   @db.Uuid
  averageRating              Decimal  @db.Decimal(3, 2)
  totalReviews               Int      @default(0)
  responseRatePercent        Decimal  @db.Decimal(5, 2)
  averageResponseTimeMinutes Int      @default(0)
  verifiedListingPercent     Decimal  @db.Decimal(5, 2)
  inquiryAcceptanceRatePercent Decimal @db.Decimal(5, 2)
  reviewReportRatePercent    Decimal  @db.Decimal(5, 2)
  trustScore                 Decimal  @db.Decimal(5, 2)
  badges                     Json?
  snapshotDate               DateTime @db.Date
  createdAt                  DateTime @default(now()) @db.Timestamptz(6)

  landlord User @relation(fields: [landlordId], references: [id], onDelete: Cascade)

  @@unique([landlordId, snapshotDate])
  @@index([landlordId])
  @@index([snapshotDate])
  @@map("landlord_reputation_snapshots")
}

model PropertyQualitySnapshot {
  id                          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  propertyId                  String   @db.Uuid
  overallQualityScore         Decimal  @db.Decimal(5, 2)
  imageCompletenessScore      Decimal  @db.Decimal(5, 2)
  descriptionCompletenessScore Decimal @db.Decimal(5, 2)
  verifiedLandlordBonus       Decimal  @db.Decimal(5, 2)
  reviewRatingScore           Decimal  @db.Decimal(5, 2)
  responseRateScore           Decimal  @db.Decimal(5, 2)
  complaintPenalty            Decimal  @db.Decimal(5, 2)
  freshnessScore              Decimal  @db.Decimal(5, 2)
  isPublishReady              Boolean  @default(true)
  snapshotDate                DateTime @db.Date
  createdAt                   DateTime @default(now()) @db.Timestamptz(6)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, snapshotDate])
  @@index([propertyId])
  @@index([snapshotDate])
  @@map("property_quality_snapshots")
}

model TrustEvent {
  id          String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  entityType  String         @db.VarChar(50)
  entityId    String         @db.Uuid
  eventType   TrustEventType
  impactDelta Decimal        @db.Decimal(5, 2)
  metadata    Json?
  createdAt   DateTime       @default(now()) @db.Timestamptz(6)

  @@index([entityType, entityId])
  @@index([eventType])
  @@index([createdAt])
  @@map("trust_events")
}

model TrustScoreHistory {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  entityType   String   @db.VarChar(50)
  entityId     String   @db.Uuid
  scoreBefore  Decimal  @db.Decimal(5, 2)
  scoreAfter   Decimal  @db.Decimal(5, 2)
  reason       String   @db.VarChar(255)
  calculatedAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([entityType, entityId])
  @@index([calculatedAt])
  @@map("trust_score_history")
}

// ==========================================
// PHASE 12: SAVED SEARCHES, ALERTS, RECOMMENDATIONS & DISCOVERY
// ==========================================

model NotificationPreference {
  id              String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId          String   @unique @db.Uuid
  emailAlerts     Boolean  @default(true)
  pushAlerts      Boolean  @default(true)
  inAppAlerts     Boolean  @default(true)
  instantAlerts   Boolean  @default(true)
  dailyDigest     Boolean  @default(true)
  weeklyDigest    Boolean  @default(true)
  recommendations Boolean  @default(true)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model SavedSearch {
  id              String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId          String               @db.Uuid
  name            String               @db.VarChar(150)
  filters         Json
  filterSignature String               @db.VarChar(64)
  eligibility     PropertyEligibility?
  localityId      String?              @db.Uuid
  propertyType    PropertyType?
  minPrice        Decimal?             @db.Decimal(12, 2)
  maxPrice        Decimal?             @db.Decimal(12, 2)
  bedrooms        Int?
  bathrooms       Int?
  furnishing      String?              @db.VarChar(50)
  sortPreference  String?              @db.VarChar(50)
  alertsEnabled   Boolean              @default(true)
  frequency       AlertFrequency       @default(INSTANT)
  lastNotifiedAt  DateTime?            @db.Timestamptz(6)
  createdAt       DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @db.Timestamptz(6)

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  alerts SearchAlert[]

  @@index([userId])
  @@index([filterSignature])
  @@index([alertsEnabled, frequency])
  @@index([eligibility, localityId])
  @@map("saved_searches")
}

model SearchAlert {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  savedSearchId String   @db.Uuid
  userId        String   @db.Uuid
  propertyId    String   @db.Uuid
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  savedSearch SavedSearch           @relation(fields: [savedSearchId], references: [id], onDelete: Cascade)
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  property    Property              @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  deliveries  SearchAlertDelivery[]

  @@unique([savedSearchId, propertyId])
  @@index([userId, isRead])
  @@index([propertyId])
  @@map("search_alerts")
}

model SearchAlertDelivery {
  id            String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  searchAlertId String              @db.Uuid
  channel       String              @db.VarChar(30)
  status        AlertDeliveryStatus @default(PENDING)
  failureReason String?             @db.Text
  deliveredAt   DateTime?           @db.Timestamptz(6)
  createdAt     DateTime            @default(now()) @db.Timestamptz(6)

  searchAlert SearchAlert @relation(fields: [searchAlertId], references: [id], onDelete: Cascade)

  @@index([searchAlertId, channel])
  @@index([status])
  @@map("search_alert_deliveries")
}

model RecentlyViewedProperty {
  id               String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId           String?  @db.Uuid
  sessionId        String?  @db.VarChar(100)
  propertyId       String   @db.Uuid
  viewedAt         DateTime @default(now()) @db.Timestamptz(6)
  dwellTimeSeconds Int      @default(0)
  source           String?  @db.VarChar(50)

  user     User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([userId, viewedAt])
  @@index([sessionId, viewedAt])
  @@index([propertyId])
  @@map("recently_viewed_properties")
}

model RecommendationEvent {
  id                 String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId             String?  @db.Uuid
  sessionId          String?  @db.VarChar(100)
  propertyId         String   @db.Uuid
  recommendationType String   @db.VarChar(50)
  reason             String   @db.VarChar(100)
  score              Decimal? @db.Decimal(5, 2)
  action             String?  @db.VarChar(50)
  metadata           Json?
  createdAt          DateTime @default(now()) @db.Timestamptz(6)

  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([userId, recommendationType])
  @@index([propertyId])
  @@index([createdAt])
  @@map("recommendation_events")
}

model PropertyImpression {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  propertyId String   @db.Uuid
  userId     String?  @db.Uuid
  sessionId  String?  @db.VarChar(100)
  surface    String   @db.VarChar(50)
  position   Int?
  metadata   Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([propertyId, createdAt])
  @@index([userId])
  @@index([surface])
  @@map("property_impressions")
}

model PropertyClick {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  propertyId String   @db.Uuid
  userId     String?  @db.Uuid
  sessionId  String?  @db.VarChar(100)
  surface    String   @db.VarChar(50)
  position   Int?
  metadata   Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([propertyId, createdAt])
  @@index([userId])
  @@index([surface])
  @@map("property_clicks")
}

model SearchQueryLog {
  id              String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId          String?   @db.Uuid
  sessionId       String?   @db.VarChar(100)
  queryText       String?   @db.VarChar(255)
  filters         Json
  localityId      String?   @db.Uuid
  resultsCount    Int       @default(0)
  executionTimeMs Int?
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)

  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  locality Locality? @relation(fields: [localityId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([localityId])
  @@index([createdAt])
  @@map("search_query_logs")
}

model LocalityDemandSnapshot {
  id                 String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  localityId         String        @db.Uuid
  period             String        @db.VarChar(20)
  snapshotDate       DateTime      @db.Date
  searchCount        Int           @default(0)
  impressionCount    Int           @default(0)
  clickCount         Int           @default(0)
  inquiryCount       Int           @default(0)
  savedSearchCount   Int           @default(0)
  averageRentDemand  Decimal?      @db.Decimal(12, 2)
  topPropertyType    PropertyType?
  studentDemandRatio Float         @default(0.5)
  metadata           Json?
  createdAt          DateTime      @default(now()) @db.Timestamptz(6)

  locality Locality @relation(fields: [localityId], references: [id], onDelete: Cascade)

  @@unique([localityId, period, snapshotDate])
  @@index([localityId])
  @@index([snapshotDate])
  @@map("locality_demand_snapshots")
}

