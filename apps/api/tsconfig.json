{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "allowJs": true,
    "declaration": false,
    "declarationMap": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@rental-peshawar/shared-types": ["../../packages/shared-types/dist/index.d.ts"],
      "@rental-peshawar/config": ["../../packages/config/dist/index.d.ts"],
      "@rental-peshawar/ui": ["../../packages/ui/dist/index.d.ts"]
    }
  },
  "include": ["src/**/*", "test/**/*", "prisma/**/*"]
}
