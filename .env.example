# ==============================================================================
# RENTAL PLATFORM PESHAWAR - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
LOG_LEVEL=info

# Database (PostgreSQL + PostGIS)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rental_peshawar?schema=public"

# Cache & Rate-Limiting Store (Redis)
REDIS_URL="redis://localhost:6379"

# Authentication Secrets & Expiration
JWT_ACCESS_SECRET="peshawar_dev_jwt_access_secret_super_secure_minimum_32_chars"
JWT_REFRESH_SECRET="peshawar_dev_jwt_refresh_secret_super_secure_minimum_32_chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Media Storage Adapter (Cloudinary)
CLOUDINARY_CLOUD_NAME="peshawar-rentals"
CLOUDINARY_API_KEY="dev_cloudinary_api_key"
CLOUDINARY_API_SECRET="dev_cloudinary_api_secret"

# S3-Compatible Storage Adapter (MinIO for Local Development / AWS S3)
STORAGE_PROVIDER="s3"
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="peshawar-rental-media"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin123"
S3_REGION="us-east-1"
S3_FORCE_PATH_STYLE="true"

# Maps Adapter (google | osm)
MAP_PROVIDER="osm"
GOOGLE_MAPS_API_KEY="AIzaSy_DEV_GOOGLE_MAPS_API_KEY_PLACEHOLDER"

# Push Notifications (Firebase Cloud Messaging)
FCM_SERVER_KEY_OR_SERVICE_ACCOUNT="{}"

# Service URLs & Deep Links
WEB_URL="http://localhost:3000"
ADMIN_URL="http://localhost:3001"
MOBILE_DEEP_LINK_SCHEME="rentalpeshawar"

# Peshawar Service Boundary Validation
ENFORCE_PESHAWAR_BOUNDARY="true"

