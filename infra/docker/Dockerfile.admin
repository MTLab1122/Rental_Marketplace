FROM node:22-alpine AS builder

WORKDIR /app

RUN npm install -g pnpm@12.18.0

COPY pnpm-lock.yaml* pnpm-workspace.yaml package.json ./
COPY packages/ ./packages/
COPY apps/admin/ ./apps/admin/

RUN pnpm install --frozen-lockfile || pnpm install
RUN pnpm --filter @rental-peshawar/shared-types build
RUN pnpm --filter @rental-peshawar/config build
RUN pnpm --filter @rental-peshawar/ui build
RUN pnpm --filter @rental-peshawar/admin build

FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
RUN npm install -g pnpm@12.18.0

COPY --from=builder /app/package.json ./
COPY --from=builder /app/pnpm-workspace.yaml ./
COPY --from=builder /app/apps/admin/ ./apps/admin/
COPY --from=builder /app/node_modules/ ./node_modules/

EXPOSE 3001

CMD ["pnpm", "--filter", "@rental-peshawar/admin", "start"]

