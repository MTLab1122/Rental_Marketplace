{
  "Version": "2012-10-17",
  "Id": "RentalPeshawarMediaSecurityPolicy",
  "Statement": [
    {
      "Sid": "EnforceTlsOnly",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": ["arn:aws:s3:::rental-peshawar-media", "arn:aws:s3:::rental-peshawar-media/*"],
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "false"
        }
      }
    },
    {
      "Sid": "DenyPublicBucketListing",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::rental-peshawar-media",
      "Condition": {
        "StringNotLike": {
          "aws:PrincipalArn": [
            "arn:aws:iam::*:role/RentalPeshawarApiRole",
            "arn:aws:iam::*:role/RentalPeshawarBackupRole"
          ]
        }
      }
    },
    {
      "Sid": "DenyPublicWrite",
      "Effect": "Deny",
      "Principal": "*",
      "Action": ["s3:PutObject", "s3:DeleteObject", "s3:DeleteObjectVersion"],
      "Resource": "arn:aws:s3:::rental-peshawar-media/*",
      "Condition": {
        "StringNotLike": {
          "aws:PrincipalArn": ["arn:aws:iam::*:role/RentalPeshawarApiRole"]
        }
      }
    },
    {
      "Sid": "DenyUnencryptedObjectUploads",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::rental-peshawar-media/*",
      "Condition": {
        "StringNotEquals": {
          "s3:x-amz-server-side-encryption": "AES256"
        }
      }
    },
    {
      "Sid": "RestrictPrivateVerificationDocumentsToAdminRole",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::rental-peshawar-media/verifications/*",
      "Condition": {
        "StringNotLike": {
          "aws:PrincipalArn": [
            "arn:aws:iam::*:role/RentalPeshawarApiRole",
            "arn:aws:iam::*:role/RentalPeshawarModerationRole"
          ]
        }
      }
    }
  ]
}
